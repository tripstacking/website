---
import Button from "@components/Button/Button.astro";
import Faq1 from "@components/Faq/Faq1.astro";
import Testimonials1 from "@components/Testimonials/Testimonials1.astro";
import { getLocaleFromUrl } from "@js/localeUtils";
import { getTranslatedData } from "@js/translationUtils";
import BaseLayout from "@layouts/BaseLayout.astro";
import HeroMapBackground from "../../../../shared/hero-map/HeroMapBackground.astro";

const currLocale = getLocaleFromUrl(Astro.url);
const siteData = getTranslatedData("siteData", currLocale);
---

<BaseLayout title={siteData.title} description={siteData.description}>
  <!-- HERO: Galaxy Atmospheric Grid & Harbor Night CarPlay Aesthetic -->
  <section id="hero-galaxy" class="relative flex w-full overflow-hidden bg-[#0F1D22] pt-32 pb-24 text-[#F7FBF9] md:pt-36 md:pb-28">
    <HeroMapBackground variant="dark" />
    <!-- Horizon Teal (#44C0C5) & Flow Green (#77C57F) Atmospheric Glow -->
    <div
      class="pointer-events-none absolute inset-0 bottom-1/2 mx-auto aspect-square w-[60%] max-w-4xl -translate-y-1/2 rounded-full bg-[#44C0C5]/25 blur-[110px]"
      aria-hidden="true"
    >
    </div>

    <!-- Galaxy Architectural Grid SVG -->
    <div class="pointer-events-none absolute inset-0 flex overflow-hidden opacity-20">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-full w-full text-[#44C0C5]" aria-hidden="true">
        <defs>
          <pattern id="galaxy-grid" width="60" height="60" patternUnits="userSpaceOnUse">
            <path d="M 60 0 L 0 0 0 60" fill="none" stroke="currentColor" stroke-width="1"></path>
          </pattern>
        </defs>
        <rect width="100%" height="100%" fill="url(#galaxy-grid)"></rect>
      </svg>
    </div>

    <div class="site-container relative z-10 mx-auto max-w-5xl px-4 text-center">
      <div class="mb-5 inline-flex items-center gap-2.5 rounded-full border border-[#44C0C5]/40 bg-[#1A2E35] px-4 py-1.5 text-xs font-semibold text-[#F7FBF9]">
        <span class="size-2 rounded-full bg-[#FFDE59]"></span>
        <span>GALAXY THEME • HARBOR NIGHT & CARPLAY EDITION</span>
      </div>

      <h1 class="mx-auto mb-6 max-w-4xl bg-gradient-to-r from-[#F7FBF9] via-[#44C0C5] to-[#77C57F] bg-clip-text text-5xl leading-tight font-extrabold tracking-tight text-transparent md:text-7xl">
        STACK YOUR STOPS. OWN YOUR WEEK.
      </h1>

      <p class="mx-auto mb-10 max-w-2xl text-lg leading-relaxed text-[#B5CCC5]">
        Maintain a living Constraint-Aware Place To-Do List. Trip Stacking partitions your stops across Multi-Day calendar windows, minimizes unprotected left turns, and hands off a single clean route to Apple Maps, Google Maps, and Apple CarPlay.
      </p>

      <div class="mx-auto mb-14 flex flex-wrap justify-center gap-4">
        <Button variant="primary" href="#pillars">
          Explore the 4 Core Pillars
        </Button>
        <Button variant="outline" href="#carplay">
          Preview CarPlay Dashboard
        </Button>
      </div>

      <!-- Galaxy Harbor Slate Squircle & S-Curve Route Preview -->
      <div class="mx-auto max-w-4xl rounded-3xl border border-[#243E47] bg-[#1A2E35]/95 p-6 text-left shadow-2xl md:p-8">
        <div class="flex flex-wrap items-center justify-between gap-4 border-b border-[#243E47] pb-5">
          <div class="flex items-center gap-4">
            <img
              src="/brand/logo-mark.svg"
              alt="Trip Stacking Stacked Route Mark"
              width="56"
              height="56"
              fetchpriority="high"
              class="size-14 rounded-2xl"
            />
            <div>
              <span class="font-mono text-xs font-bold text-[#FFDE59]">THE STACKED ROUTE MARK • 60-30-10 SYSTEM</span>
              <h2 class="text-xl font-bold text-[#F7FBF9]">Three Stacked Errand Pills + Smooth S-Curve Spine</h2>
            </div>
          </div>
          <span class="rounded-full bg-[#0F1D22] px-3.5 py-1.5 font-mono text-xs text-[#77C57F]">
            Valhalla Turn-Costing Active
          </span>
        </div>

        <div class="mt-6 grid gap-4 md:grid-cols-3">
          <div class="rounded-2xl border border-[#FFDE59]/40 bg-[#0F1D22] p-4">
            <span class="font-mono text-xs font-bold text-[#FFDE59]">TOP PILL • #FFDE59</span>
            <h3 class="mt-1 font-bold text-[#F7FBF9]">Beacon Yellow Waypoints</h3>
            <p class="mt-1 text-xs text-[#B5CCC5]">
              Store opening windows, priority sequencing badges, and consolidated calendar blocks.
            </p>
          </div>
          <div class="rounded-2xl border border-[#77C57F]/40 bg-[#0F1D22] p-4">
            <span class="font-mono text-xs font-bold text-[#77C57F]">MIDDLE PILL • #77C57F</span>
            <h3 class="mt-1 font-bold text-[#F7FBF9]">Flow Green Day-Splitting</h3>
            <p class="mt-1 text-xs text-[#B5CCC5]">
              Offset horizontally to express dynamic day-splitting and low-stress green-light corridors.
            </p>
          </div>
          <div class="rounded-2xl border border-[#44C0C5]/40 bg-[#0F1D22] p-4">
            <span class="font-mono text-xs font-bold text-[#44C0C5]">BOTTOM PILL • #44C0C5</span>
            <h3 class="mt-1 font-bold text-[#F7FBF9]">Horizon Teal Anchor</h3>
            <p class="mt-1 text-xs text-[#B5CCC5]">
              Grounds the stack into a single actionable trip exported to Apple Maps, Google Maps, or CarPlay.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 4 CORE PILLARS -->
  <section id="pillars" class="bg-[#F7FBF9] py-20 text-[#1A2E35] dark:bg-[#0F1D22] dark:text-[#F7FBF9]">
    <div id="how-it-works" class="site-container mx-auto max-w-6xl px-4">
      <div class="mx-auto mb-14 max-w-3xl text-center">
        <span class="mb-2 inline-block font-mono text-xs font-bold tracking-wider text-[#1F8388] uppercase dark:text-[#44C0C5]">
          Calm Over Complexity
        </span>
        <h2 class="mb-4 text-3xl font-bold md:text-5xl">
          Four Core Pillars of Trip Stacking
        </h2>
      </div>

      <div id="routing" class="grid gap-6 md:grid-cols-2">
        <div class="rounded-2xl border border-[#D6E4DF] bg-white p-7 dark:border-[#243E47] dark:bg-[#1A2E35]">
          <h3 class="mb-2 text-xl font-bold">1. Constraint-Aware Place To-Do List</h3>
          <p class="text-sm text-[#4D6A64] dark:text-[#B5CCC5]">
            Combine temporal windows (store hours, day/week deadlines), configurable per-stop dwell durations, and relative precedence rules like <em>"Bank before Hardware Store"</em> or <em>"Groceries Last"</em>.
          </p>
        </div>

        <div class="rounded-2xl border border-[#D6E4DF] bg-white p-7 dark:border-[#243E47] dark:bg-[#1A2E35]">
          <h3 class="mb-2 text-xl font-bold">2. Intelligent Multi-Day & Low-Stress Optimization</h3>
          <p class="text-sm text-[#4D6A64] dark:text-[#B5CCC5]">
            Automatically groups compatible errands, splits overflow onto separate days, avoids venue crowds, penalizes unprotected left turns, and adapts to your trusted local corridors.
          </p>
        </div>

        <div class="rounded-2xl border border-[#D6E4DF] bg-white p-7 dark:border-[#243E47] dark:bg-[#1A2E35]">
          <h3 class="mb-2 text-xl font-bold">3. Holistic Calendar Integration</h3>
          <p class="text-sm text-[#4D6A64] dark:text-[#B5CCC5]">
            Creates one consolidated Calendar event per stacked trip instead of cluttering your day with micro-events—complete with total drive + dwell duration and a one-tap launch link.
          </p>
        </div>

        <div id="carplay" class="rounded-2xl border border-[#D6E4DF] bg-white p-7 dark:border-[#243E47] dark:bg-[#1A2E35]">
          <h3 class="mb-2 text-xl font-bold">4. Seamless Apple Maps, Google Maps & CarPlay</h3>
          <p class="text-sm text-[#4D6A64] dark:text-[#B5CCC5]">
            Export multi-stop routes directly to Apple Maps or Google Maps when supported, or navigate natively inside Trip Stacking on iOS and Apple CarPlay.
          </p>
        </div>
      </div>
    </div>
  </section>

  <Testimonials1 />

  <div id="faq">
    <Faq1 />
  </div>
</BaseLayout>
