    "@astrojs/markdown-remark": "7.2.1",
    "@eslint/js": "9.37.0",
    "@playform/compress": "0.2.3",
    "eslint": "9.37.0",
    "eslint-plugin-astro": "1.3.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-prettier": "5.5.4",
    "eslint-plugin-simple-import-sort": "12.1.1",
