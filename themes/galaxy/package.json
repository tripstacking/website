{
  "name": "galaxy",
  "type": "module",
  "version": "9.0.0",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "astro dev",
    "winsearch": "robocopy dist/pagefind public/pagefind /E",
    "osxsearch": "cp -r dist/pagefind public/",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "config-i18n": "node ./scripts/config-i18n.js",
    "remove-keystatic": "node ./scripts/remove-keystatic.js",
    "format": "eslint . --fix && prettier -w \"**/*\" --ignore-unknown --cache",
    "lint": "eslint .",
    "cf:dev": "wrangler dev",
    "cf:deploy": "wrangler deploy"
  },
  "dependencies": {
    "@astrojs/mdx": "7.0.3",
    "@astrojs/react": "6.0.1",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.3",
    "@fontsource-variable/inter": "5.2.8",
    "@fontsource/inter": "5.2.8",
    "@pagefind/default-ui": "1.4.0",
    "@tabler/icons": "3.35.0",
    "@tailwindcss/forms": "0.5.10",
    "@tailwindcss/vite": "4.3.2",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "astro": "^7.4.1",
    "astro-icon": "1.1.5",
    "astro-seo": "0.8.4",
    "motion-on-scroll": "^1.0.0",
    "piccolore": "0.1.3",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "tailwind-merge": "^3.3.1",
