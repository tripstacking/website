---
import Button from "@components/Button/Button.astro";
import FaqCards from "@components/Faq/FaqCards.astro";
import PricingFourCards from "@components/Pricing/PricingFourCards.astro";
import { getLocaleFromUrl } from "@js/localeUtils";
import { getTranslatedData } from "@js/translationUtils";
import BaseLayout from "@layouts/BaseLayout.astro";
import HeroMapBackground from "@components/hero-map/HeroMapBackground.astro";

const currLocale = getLocaleFromUrl(Astro.url);
const siteData = getTranslatedData("siteData", currLocale);
---

<BaseLayout title={siteData.title} description={siteData.description}>
  <!-- HERO: Nova Alternating Dark Section (#0F1D22 Harbor Night / #1A2E35 Harbor Slate) -->
  <section id="hero-nova" class="dark relative mt-[4.5rem] overflow-clip bg-[#0F1D22] text-[#F7FBF9]">
    <HeroMapBackground variant="dark" />
    <div class="site-container relative z-10 mx-auto px-4 pt-12 pb-20 md:py-24">
      <div class="-mx-4 flex max-w-7xl flex-wrap items-center">
        <!-- Left: Stacked Trip Interactive Card Preview -->
        <div class="mb-14 w-full px-4 md:mb-0 md:w-1/2 lg:pr-10">
          <div class="relative mx-auto max-w-lg rounded-3xl border border-[#243E47] bg-[#1A2E35] p-6 shadow-2xl">
            <div class="mb-5 flex items-center justify-between border-b border-[#243E47] pb-4">
              <div class="flex items-center gap-3">
                <img
                  src="/brand/logo-mark.svg"
                  alt="Trip Stacking Stacked Route Mark"
                  width="48"
                  height="48"
                  fetchpriority="high"
                  class="size-12 rounded-xl"
                />
                <div>
                  <span class="block text-xs font-semibold tracking-wider text-[#44C0C5] uppercase">
                    Consolidated Calendar Event
                  </span>
                  <h2 class="text-lg font-bold text-[#F7FBF9]">Tuesday Afternoon Stack</h2>
                </div>
              </div>
              <span class="rounded-full bg-[#FFDE59] px-3 py-1 font-mono text-xs font-bold text-[#1A2E35]">
                2:00 – 3:15 PM
              </span>
            </div>

            <!-- 3 Stacked Errand Pills matching the Logo Mark -->
            <div class="space-y-3">
              <div class="flex items-center justify-between rounded-2xl border border-[#FFDE59]/40 bg-[#0F1D22]/90 p-3.5">
                <div class="flex items-center gap-3">
                  <span class="flex size-7 items-center justify-center rounded-full bg-[#FFDE59] font-mono text-xs font-extrabold text-[#1A2E35]">
                    1
                  </span>
                  <div>
                    <p class="text-sm font-bold text-[#F7FBF9]">First Federal Bank</p>
                    <p class="text-xs text-[#B5CCC5]">Closes 4:00 PM • Before Hardware Store</p>
                  </div>
                </div>
                <span class="font-mono text-xs text-[#FFDE59]">15m dwell</span>
              </div>

              <div class="ml-5 flex items-center justify-between rounded-2xl border border-[#77C57F]/50 bg-[#0F1D22]/90 p-3.5">
                <div class="flex items-center gap-3">
                  <span class="flex size-7 items-center justify-center rounded-full bg-[#77C57F] font-mono text-xs font-extrabold text-[#1A2E35]">
                    2
                  </span>
                  <div>
                    <p class="text-sm font-bold text-[#F7FBF9]">Pacific Hardware & Supply</p>
                    <p class="text-xs text-[#B5CCC5]">Low-Crowd Window • 0 Left Turns</p>
                  </div>
                </div>
                <span class="font-mono text-xs text-[#77C57F]">20m dwell</span>
              </div>

              <div class="flex items-center justify-between rounded-2xl border border-[#44C0C5]/50 bg-[#0F1D22]/90 p-3.5">
                <div class="flex items-center gap-3">
                  <span class="flex size-7 items-center justify-center rounded-full bg-[#44C0C5] font-mono text-xs font-extrabold text-[#1A2E35]">
                    3
                  </span>
                  <div>
                    <p class="text-sm font-bold text-[#F7FBF9]">Harbor Market Groceries</p>
                    <p class="text-xs text-[#B5CCC5]">Pinned Last • Perishables Cold</p>
                  </div>
                </div>
                <span class="font-mono text-xs text-[#44C0C5]">25m dwell</span>
              </div>
            </div>

            <div class="mt-5 flex flex-wrap items-center justify-between gap-2 rounded-xl bg-[#0F1D22] px-4 py-3 text-xs text-[#B5CCC5]">
              <span>🚗 15m total drive • Right-turn corridor</span>
              <span class="font-semibold text-[#44C0C5]">Open in App & CarPlay →</span>
            </div>
          </div>
        </div>

        <!-- Right: Headline & Manifesto Intro -->
        <div class="w-full px-4 md:w-1/2 lg:pl-8">
          <div class="mb-4 inline-flex items-center gap-2 rounded-full border border-[#44C0C5]/40 bg-[#1A2E35] px-3.5 py-1 text-xs font-semibold text-[#44C0C5]">
            <span class="size-2 rounded-full bg-[#FFDE59]"></span>
            <span>NOVA THEME • CALM OVER COMPLEXITY</span>
          </div>
          <h1 class="mb-6 font-sans text-[clamp(1.75rem,8vw,2.75rem)] leading-tight font-extrabold tracking-tight text-[#F7FBF9] md:text-[clamp(1.75rem,3.4vw,3.25rem)]">
            <span class="block whitespace-nowrap">STACK YOUR STOPS.</span>
            <span class="block whitespace-nowrap">OWN YOUR WEEK.</span>
          </h1>
          <p class="mb-8 text-lg leading-relaxed text-[#B5CCC5]">
            Traditional to-do lists know <em>what</em> you need to do, and navigation apps know <em>how</em> to get from A to B—but neither orchestrates <strong>when</strong> and <strong>in what order</strong> to combine stops. Trip Stacking turns your living places to-do list into calm, multi-stop loops that fit naturally into your calendar.
          </p>
          <div class="flex flex-wrap gap-4">
            <Button variant="primary" href="#pillars">
              Explore the 4 Core Pillars
            </Button>
            <Button variant="outline" href="#how-it-works">
              See Multi-Day Optimization
            </Button>
          </div>
          <div class="mt-8 grid grid-cols-3 gap-4 border-t border-[#243E47] pt-6 text-left">
            <div>
              <p class="font-mono text-xl font-bold text-[#44C0C5]">1 Block</p>
              <p class="text-xs text-[#B5CCC5]">Per stacked trip on your calendar</p>
            </div>
            <div>
              <p class="font-mono text-xl font-bold text-[#77C57F]">Low-Stress</p>
              <p class="text-xs text-[#B5CCC5]">Minimizes unprotected left turns</p>
            </div>
            <div>
              <p class="font-mono text-xl font-bold text-[#FFDE59]">1-Tap</p>
              <p class="text-xs text-[#B5CCC5]">In-App Route View & CarPlay</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- PILLARS: Nova Light Section (#F7FBF9 Alabaster Mint) -->
  <section id="pillars" class="bg-[#F7FBF9] py-20 text-[#1A2E35] dark:bg-[#0F1D22] dark:text-[#F7FBF9]">
    <div class="site-container mx-auto max-w-7xl px-4">
      <div class="mx-auto mb-14 max-w-3xl text-center">
        <span class="mb-3 inline-block rounded-full bg-[#D7F3F4] px-3.5 py-1 text-xs font-bold tracking-wider text-[#1D696E] uppercase dark:bg-[#1A2E35] dark:text-[#44C0C5]">
          The Trip Stacking Manifesto
        </span>
        <h2 class="mb-4 font-sans text-3xl font-extrabold tracking-tight md:text-5xl">
          Four Pillars for a Calm, Effortless Week
        </h2>
        <p class="text-base text-[#4D6A64] dark:text-[#B5CCC5]">
          Designed around our 60-30-10 visual system—Alabaster Mint (#F7FBF9), Harbor Slate (#1A2E35), Horizon Teal (#44C0C5), Flow Green (#77C57F), and Beacon Yellow (#FFDE59).
        </p>
      </div>

      <div class="grid gap-6 md:grid-cols-2">
        <!-- Pillar 1 -->
        <div class="rounded-3xl border border-[#D6E4DF] bg-white p-8 shadow-sm dark:border-[#243E47] dark:bg-[#1A2E35]">
          <div class="mb-4 inline-flex items-center gap-2 rounded-xl bg-[#FFDE59] px-3 py-1.5 text-xs font-extrabold text-[#1A2E35]">
            <span>PILLAR 01</span>
            <span>•</span>
            <span>PLACES TO-DO LIST</span>
          </div>
          <h3 class="mb-3 text-2xl font-bold">Constraint-Aware Place To-Do List</h3>
          <p class="mb-4 text-sm leading-relaxed text-[#4D6A64] dark:text-[#B5CCC5]">
            Every destination starts as a rich, flexible item on your places to-do list—from a casual dry-cleaning drop-off to finely constrained errands:
          </p>
          <ul class="space-y-2 text-sm">
            <li class="flex items-start gap-2">
              <span class="mt-1 size-2 shrink-0 rounded-full bg-[#FFDE59]"></span>
              <span><strong>Temporal Windows:</strong> Store hours, time-of-day, day-of-week, or week-level deadlines.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="mt-1 size-2 shrink-0 rounded-full bg-[#77C57F]"></span>
              <span><strong>Stop Duration:</strong> Configurable dwell time per stop (15m post office, 45m dentist) for exact arrival/departure math.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="mt-1 size-2 shrink-0 rounded-full bg-[#44C0C5]"></span>
              <span><strong>Relative Priority & Precedence:</strong> Sequence rules like <em>"Bank before Hardware Store"</em> or <em>"Groceries Last"</em> so frozen items stay cold.</span>
            </li>
          </ul>
        </div>

        <!-- Pillar 2 -->
        <div class="rounded-3xl border border-[#D6E4DF] bg-white p-8 shadow-sm dark:border-[#243E47] dark:bg-[#1A2E35]">
          <div class="mb-4 inline-flex items-center gap-2 rounded-xl bg-[#77C57F] px-3 py-1.5 text-xs font-extrabold text-[#1A2E35]">
            <span>PILLAR 02</span>
            <span>•</span>
            <span>MULTI-DAY VRP ENGINE</span>
          </div>
          <h3 class="mb-3 text-2xl font-bold">Intelligent Multi-Day & Multi-Stop Optimization</h3>
          <p class="mb-4 text-sm leading-relaxed text-[#4D6A64] dark:text-[#B5CCC5]">
            Trip Stacking partitions and sequences stops across your entire week to minimize total time, distance, and driving stress:
          </p>
          <ul class="space-y-2 text-sm">
            <li class="flex items-start gap-2">
              <span class="mt-1 size-2 shrink-0 rounded-full bg-[#77C57F]"></span>
              <span><strong>Dynamic Day Splitting:</strong> Groups compatible stops together and automatically splits overflow onto separate days.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="mt-1 size-2 shrink-0 rounded-full bg-[#44C0C5]"></span>
              <span><strong>Crowd & Traffic Avoidance:</strong> Schedules visits when venues are quieter and surrounding road corridors flow smoothly.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="mt-1 size-2 shrink-0 rounded-full bg-[#FFDE59]"></span>
              <span><strong>Low-Stress Routing:</strong> Penalizes unprotected left turns across heavy traffic and adapts to your trusted local roads.</span>
            </li>
          </ul>
        </div>

        <!-- Pillar 3 -->
        <div class="rounded-3xl border border-[#D6E4DF] bg-white p-8 shadow-sm dark:border-[#243E47] dark:bg-[#1A2E35]">
          <div class="mb-4 inline-flex items-center gap-2 rounded-xl bg-[#44C0C5] px-3 py-1.5 text-xs font-extrabold text-[#1A2E35]">
            <span>PILLAR 03</span>
            <span>•</span>
            <span>SACRED CALENDAR SPACE</span>
          </div>
          <h3 class="mb-3 text-2xl font-bold">Holistic Calendar Integration</h3>
          <p class="mb-4 text-sm leading-relaxed text-[#4D6A64] dark:text-[#B5CCC5]">
            Your calendar should reflect how you actually experience your day—not a cluttered wall of fragmented micro-events:
          </p>
          <ul class="space-y-2 text-sm">
            <li class="flex items-start gap-2">
              <span class="mt-1 size-2 shrink-0 rounded-full bg-[#44C0C5]"></span>
              <span><strong>One Event Per Stacked Trip:</strong> A single clean block from home departure to final return.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="mt-1 size-2 shrink-0 rounded-full bg-[#77C57F]"></span>
              <span><strong>Accurate Block Sizing:</strong> Combines live travel segments and per-stop dwell durations into one reliable block.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="mt-1 size-2 shrink-0 rounded-full bg-[#FFDE59]"></span>
              <span><strong>Embedded Deep Link:</strong> Tap the calendar notification to launch your ordered multi-stop route immediately.</span>
            </li>
          </ul>
        </div>

        <!-- Pillar 4 -->
        <div id="carplay" class="rounded-3xl border border-[#D6E4DF] bg-white p-8 shadow-sm dark:border-[#243E47] dark:bg-[#1A2E35]">
          <div class="mb-4 inline-flex items-center gap-2 rounded-xl bg-[#1A2E35] px-3 py-1.5 text-xs font-extrabold text-[#FFDE59] dark:bg-[#0F1D22]">
            <span>PILLAR 04</span>
            <span>•</span>
            <span>IN-APP ROUTE & CARPLAY</span>
          </div>
          <h3 class="mb-3 text-2xl font-bold">In-App Route Display & Native CarPlay</h3>
          <p class="mb-4 text-sm leading-relaxed text-[#4D6A64] dark:text-[#B5CCC5]">
            When a stacked trip begins, getting on the road is zero-friction from your calendar notification to your dashboard:
          </p>
          <ul class="space-y-2 text-sm">
            <li class="flex items-start gap-2">
              <span class="mt-1 size-2 shrink-0 rounded-full bg-[#44C0C5]"></span>
              <span><strong>Built-In Multi-Stop Map:</strong> View and follow your complete ordered route directly inside the Trip Stacking app—no exporting to external map apps required.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="mt-1 size-2 shrink-0 rounded-full bg-[#77C57F]"></span>
              <span><strong>Native CarPlay Dashboard:</strong> Built Apple-first so your stacked stops, dwell timers, and low-stress route appear right on your CarPlay screen.</span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- HOW IT WORKS & LOW-STRESS ROUTING: Nova Dark Section (#1A2E35 Harbor Slate) -->
  <section id="how-it-works" class="dark bg-[#1A2E35] py-20 text-[#F7FBF9]">
    <div id="routing" class="site-container mx-auto max-w-7xl px-4">
      <div class="mx-auto mb-14 max-w-3xl text-center">
        <span class="mb-3 inline-block rounded-full bg-[#0F1D22] px-3.5 py-1 font-mono text-xs font-bold text-[#77C57F] uppercase">
          Valhalla + VROOM Optimization Architecture
        </span>
        <h2 class="mb-4 font-sans text-3xl font-extrabold tracking-tight md:text-5xl">
          From Scattered Errands to One Smooth S-Curve
        </h2>
        <p class="text-[#B5CCC5]">
          Every element of the Trip Stacking Stacked Route Mark maps directly to how our optimization engine orchestrates your week.
        </p>
      </div>

      <div class="grid gap-6 md:grid-cols-4">
        <div class="rounded-2xl border border-[#243E47] bg-[#0F1D22] p-6">
          <span class="mb-3 inline-block rounded-lg bg-[#FFDE59] px-2.5 py-1 font-mono text-xs font-extrabold text-[#1A2E35]">
            STEP 01
          </span>
          <h3 class="mb-2 text-lg font-bold text-[#F7FBF9]">Capture Places & Rules</h3>
          <p class="text-sm text-[#B5CCC5]">
            Add stops with dwell times (15m–60m), store hours, and precedence rules like "Groceries Last".
          </p>
        </div>
        <div class="rounded-2xl border border-[#243E47] bg-[#0F1D22] p-6">
          <span class="mb-3 inline-block rounded-lg bg-[#77C57F] px-2.5 py-1 font-mono text-xs font-extrabold text-[#1A2E35]">
            STEP 02
          </span>
          <h3 class="mb-2 text-lg font-bold text-[#F7FBF9]">Low-Stress Costing</h3>
          <p class="text-sm text-[#B5CCC5]">
            Evaluates traffic, venue busyness, and turn penalties to avoid unprotected left turns across busy arterials.
          </p>
        </div>
        <div class="rounded-2xl border border-[#243E47] bg-[#0F1D22] p-6">
          <span class="mb-3 inline-block rounded-lg bg-[#44C0C5] px-2.5 py-1 font-mono text-xs font-extrabold text-[#1A2E35]">
            STEP 03
          </span>
          <h3 class="mb-2 text-lg font-bold text-[#F7FBF9]">Split & Stack Days</h3>
          <p class="text-sm text-[#B5CCC5]">
            Partitions stops into Day A and Day B loops and writes one consolidated calendar block per trip.
          </p>
        </div>
        <div class="rounded-2xl border border-[#243E47] bg-[#0F1D22] p-6">
          <span class="mb-3 inline-block rounded-lg bg-[#F7FBF9] px-2.5 py-1 font-mono text-xs font-extrabold text-[#1A2E35]">
            STEP 04
          </span>
          <h3 class="mb-2 text-lg font-bold text-[#F7FBF9]">1-Tap CarPlay Drive</h3>
          <p class="text-sm text-[#B5CCC5]">
            Tap your calendar notification to open your stacked route directly in the Trip Stacking app and on Apple CarPlay.
          </p>
        </div>
      </div>
    </div>
  </section>

  <div id="pricing">
    <PricingFourCards />
  </div>

  <div id="faq">
    <FaqCards />
  </div>
</BaseLayout>
