---
/**
 * * 4-column subscription pricing section with toggle for monthly or yearly billing
 */

import Button from "@components/Button/Button.astro";
import { Switch } from "@components/starwind/switch";
import bestValueImage from "@images/best-value.png";
import { getLocaleFromUrl } from "@js/localeUtils";
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";

import { getLocalizedRoute } from "@/js/translationUtils";

interface pricingItem {
  name: string;
  subtitle: string;
  description: string;
  featured?: boolean;
  price: {
    free?: boolean;
    monthly: string;
    yearly: string;
  };
  periodLabel?: {
    monthly: string;
    yearly: string;
  };
  features: string[];
  href: string;
  linkText: string;
}

const pricingData: pricingItem[] = [
  {
    name: "Free",
    subtitle: "Single-Trip Stacker",
    description: "Casual weekend errand runner testing the core loop.",
    price: {
      free: true,
      monthly: "0",
      yearly: "0",
    },
    periodLabel: {
      monthly: "free forever",
      yearly: "free forever",
    },
    features: [
      "Unlimited Places To-Do List",
      "Single-day trip optimization (up to 4 stops)",
      "Basic stop dwell time",
      "Export to Apple Maps & Google Maps",
    ],
    href: "/signup",
    linkText: "Start Stacking Free",
  },
  {
    name: "Local Pro",
    subtitle: "Full Week Stacker",
    description: "Solo Apple user who wants their week automated on-device.",
    price: {
      monthly: "2.99",
      yearly: "19.99",
    },
    periodLabel: {
      monthly: "per month",
      yearly: "per year",
    },
    features: [
      "Multi-day week splitting across calendar windows",
      "Up to 20 stops/week",
      'Precedence rules ("Bank before Hardware", "Groceries last")',
      "Holistic Calendar Sync (1 consolidated block/trip)",
      "Native CarPlay Dashboard + personal iCloud sync",
    ],
    href: "/signup",
    linkText: "Subscribe to Local Pro",
  },
  {
    name: "Cloud Sync",
    subtitle: "Anywhere + Low-Stress Pro",
    description: "Desktop planners, cross-platform users, and low-stress drivers.",
    featured: true,
    price: {
      monthly: "3.99",
      yearly: "29.99",
    },
    periodLabel: {
      monthly: "per month",
      yearly: "per year",
    },
    features: [
      "Everything in Local Pro",
      "Laptop Web Companion App",
      "Cross-ecosystem sync (iOS, Android, PC)",
      "Cloud Low-Stress Routing (left-turn penalties)",
      "Auto-Import Store Hours & Busyness",
    ],
    href: "/signup",
    linkText: "Subscribe to Cloud Sync",
  },
  {
    name: "Family & Household",
    subtitle: "Multi-Car VRP (Up to 5)",
    description: "Couples, busy parents, and caregivers dividing household logistics.",
    price: {
      monthly: "6.99",
      yearly: "49.99",
    },
    periodLabel: {
      monthly: "per household, per month",
      yearly: "per household, per year",
    },
    features: [
      "Everything in Cloud Sync for up to 5 members",
      'Shared Household Errand Pool ("Anyone can pick up")',
      "Multi-Car / Multi-Person VRP Solver",
      "Live Claiming & Completion Notifications",
    ],
    href: "/signup",
    linkText: "Subscribe to Family Plan",
  },
];

const currLocale = getLocaleFromUrl(Astro.url);
---

<section id="pricing-four-cards" class="bg-base-200/60 dark:bg-base-950 py-16 md:py-24">
  <div class="site-container relative">
    <div class="mx-auto max-w-3xl text-center">
      <span class="mb-3 inline-block rounded-full bg-[#D7F3F4] px-3.5 py-1 text-xs font-bold tracking-wider text-[#1D696E] uppercase dark:bg-[#1A2E35] dark:text-[#44C0C5]">
        Simple Subscription Pricing
      </span>
      <h2 class="h2 text-center">Stack Your Week at Every Scale</h2>
      <p class="description mx-auto max-w-2xl">
        Start free on a single day, or subscribe to automate your full week across iCloud, the Web Companion, and shared family calendars.
      </p>
    </div>

    <!-- Toggle switch for monthly or yearly pricing -->
    <div class="mt-6 flex justify-center">
      <label
        for="pricing-four-cards__toggle"
        class="relative inline-flex cursor-pointer items-center gap-4 select-none"
      >
        <span class="description flex items-center font-medium">Monthly</span>
        <Switch id="pricing-four-cards__toggle" variant="primary" padding={4} />
        <span class="description flex items-center font-medium">Yearly (Save up to 44%)</span>
      </label>
    </div>

    <div class="mx-auto mt-24 grid w-full gap-6 sm:grid-cols-2 md:mt-40 lg:grid-cols-4">
      {
        pricingData.map((plan) => (
          <div class="pricing-plan flex w-full">
            <div
              class="dark:bg-base-900 relative flex w-full transform flex-col justify-between bg-white p-8 transition-transform duration-500 hover:-translate-y-2"
              class:list={[
                {
                  "mt-10 rounded-b-lg sm:mt-0": plan.featured === true,
                },
                {
                  "rounded-lg": plan.featured !== true,
                },
              ]}
            >
              {plan.featured === true && (
                <div>
                  <Image
                    src={bestValueImage}
                    class="absolute -top-32 right-8 z-10 hidden md:block dark:invert"
                    alt="best value"
                    loading="lazy"
                    width={170}
                    densities={[1.5, 2]}
                  />
                  <div class="from-gradient-1 via-gradient-2 to-gradient-3 absolute -top-10 left-0 w-full rounded-t-xl bg-linear-40">
                    <p class="py-2 text-center font-semibold tracking-tight text-white">
                      Recommended
                    </p>
                  </div>
                </div>
              )}

              <div>
                <div class="text-center">
                  <h3 class="mb-1 text-xl font-bold tracking-tight">{plan.name}</h3>
                  <p class="mb-6 text-xs font-semibold tracking-wider text-[#1F8388] uppercase dark:text-[#44C0C5]">
                    {plan.subtitle}
                  </p>
                  <h4>
                    <span class="text-xl font-semibold tracking-tight">$</span>
                    <span class="pricing-monthly font-sans text-5xl font-bold tracking-tighter xl:text-6xl">
                      {plan.price.monthly}
                    </span>
                    <span class="pricing-yearly hidden font-sans text-5xl font-bold tracking-tighter xl:text-6xl">
                      {plan.price.yearly}
                    </span>
                  </h4>
                  <span class="pricing-monthly description mb-7 inline-block text-sm tracking-tight">
                    {plan.periodLabel?.monthly ?? "per month"}
                  </span>
                  <span class="pricing-yearly description mb-7 hidden text-sm tracking-tight">
                    {plan.periodLabel?.yearly ?? "per year"}
                  </span>

                  <div class="border-opacity-60 border-t border-b border-gray-300 py-6 dark:border-gray-700">
                    <p class="description mx-auto max-w-xs text-sm tracking-tight">
                      {plan.description}
                    </p>
                  </div>
                </div>
                <ul class="py-6">
                  {plan.features.map((feature) => (
                    <li class="mb-2.5 flex items-start justify-start gap-2.5">
                      <Icon
                        name="tabler/check"
                        class="text-primary-600 dark:text-primary-400 mt-0.5 size-5 shrink-0"
                        aria-hidden="true"
                      />
                      <span class="text-start text-sm font-medium">{feature}</span>
                    </li>
                  ))}
                </ul>
              </div>
              <div class="text-center">
                <Button
                  class="w-full duration-300"
                  variant={plan.featured === true ? "primary" : "secondary"}
                  href={getLocalizedRoute(currLocale, plan.href)}
                >
                  {plan.linkText}
                </Button>
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<script>
  import type { SwitchChangeEvent } from "@/components/starwind/switch";

  function pricingPlanToggleSetup() {
    const pricingSection = document.getElementById("pricing-four-cards");
    const toggle = pricingSection?.querySelector("#pricing-four-cards__toggle");
    const monthlyPrices = pricingSection?.querySelectorAll(".pricing-monthly");
    const yearlyPrices = pricingSection?.querySelectorAll(".pricing-yearly");

    if (!toggle || !monthlyPrices || !yearlyPrices) return;

    toggle.addEventListener("starwind-switch:change", (e: Event) => {
      const event = e as SwitchChangeEvent;
      const isYearly = event.detail.checked;

      monthlyPrices.forEach((price) => price.classList.toggle("hidden", isYearly));
      yearlyPrices.forEach((price) => price.classList.toggle("hidden", !isYearly));
    });
  }

  // runs on initial page load
  pricingPlanToggleSetup();

  // runs on view transitions navigation
  document.addEventListener("astro:after-swap", pricingPlanToggleSetup);
</script>
