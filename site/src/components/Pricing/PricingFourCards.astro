---
/**
 * * 4-column subscription pricing section with toggle for monthly or yearly billing
 */

import { Show } from "@clerk/astro/components";
import Button from "@components/Button/Button.astro";
import UserWaitlistAvatar from "@components/Profile/UserWaitlistAvatar.astro";
import { Switch } from "@components/starwind/switch";
import bestValueImage from "@images/best-value.png";
import { getLocaleFromUrl } from "@js/localeUtils";
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";

import { getLocalizedRoute } from "@/js/translationUtils";

interface pricingItem {
  name: string;
  subtitle: string;
  description: string;
  featured?: boolean;
  waitlist?: boolean;
  comingSoon?: boolean;
  price: {
    free?: boolean;
    monthly: string;
    yearly: string;
  };
  features: string[];
  href?: string;
  linkText: string;
}

const pricingData: pricingItem[] = [
  {
    name: "Free",
    subtitle: "Single-Trip Stacker",
    description: "For everyday single-trip errands and quick weekend runs.",
    waitlist: true,
    price: {
      free: true,
      monthly: "0",
      yearly: "0",
    },
    features: [
      "Unlimited Places To-Do List",
      "Single-day trip optimization (up to 4 stops)",
      "Custom stop durations",
      "In-app route map & Apple CarPlay",
    ],
    href: "/waitlist?tier=free",
    linkText: "Join Waitlist",
  },
  {
    name: "Local Pro",
    subtitle: "Full Week Stacker",
    description: "For solo Apple users automating a full week of errands.",
    featured: true,
    waitlist: true,
    price: {
      monthly: "2.99",
      yearly: "19.99",
    },
    features: [
      "Everything in Free",
      "Multi-day week splitting (up to 20 stops/week)",
      'Stop ordering rules ("Bank first", "Groceries last")',
      "Single consolidated calendar event per trip",
      "Personal iCloud sync across Apple devices",
    ],
    href: "/waitlist?tier=local-pro",
    linkText: "Join Waitlist",
  },
  {
    name: "Cloud Sync",
    subtitle: "Anywhere + Low-Stress Pro",
    description: "Desktop web planning and sync across all your devices.",
    comingSoon: true,
    price: {
      monthly: "3.99",
      yearly: "29.99",
    },
    features: [
      "Everything in Local Pro",
      "Laptop Web Companion App",
      "Cross-ecosystem sync (iOS, Android, PC)",
      "Cloud Low-Stress Routing (left-turn penalties)",
      "Auto-Import Store Hours & Busyness",
    ],
    linkText: "Coming Soon",
  },
  {
    name: "Family & Household",
    subtitle: "Shared Family Stacker (Up to 5)",
    description: "Shared errand lists and trip splitting for households.",
    comingSoon: true,
    price: {
      monthly: "6.99",
      yearly: "49.99",
    },
    features: [
      "Everything in Cloud Sync for up to 5 members",
      'Shared Household Errand Pool ("Anyone can pick up")',
      "Smart Multi-Driver Trip Splitting",
      "Live Claiming & Completion Notifications",
    ],
    linkText: "Coming Soon",
  },
];

const currLocale = getLocaleFromUrl(Astro.url);
---

<section id="pricing-four-cards" class="bg-base-200/60 dark:bg-base-950 py-16 md:py-24">
  <div class="site-container relative">
    <div class="mx-auto max-w-3xl text-center">
      <span class="bg-primary-100 text-primary-700 dark:bg-base-900 dark:text-primary-400 mb-3 inline-block rounded-full px-3.5 py-1 text-xs font-bold tracking-wider uppercase">
        Simple Subscription Pricing
      </span>
      <h2 class="h2 text-center">Stack Your Week at Every Scale</h2>
      <p class="description mx-auto max-w-2xl">
        Sign in to join the waitlist for Free or Local Pro today. Cloud Sync and Family &amp; Household multi-car plans are coming soon.
      </p>
    </div>

    <!-- Toggle switch for monthly or yearly pricing -->
    <div class="mt-6 flex justify-center">
      <label
        for="pricing-four-cards__toggle"
        class="relative inline-flex cursor-pointer items-center gap-4 select-none"
      >
        <span class="description flex items-center font-medium">Monthly</span>
        <Switch id="pricing-four-cards__toggle" variant="primary" padding={4} />
        <span class="description flex items-center font-medium">Yearly (Save up to 44%)</span>
      </label>
    </div>

    <div class="mx-auto mt-24 grid w-full gap-6 sm:grid-cols-2 md:mt-40 lg:grid-cols-4">
      {
        pricingData.map((plan) => (
          <div class="pricing-plan flex w-full">
            <div
              class="dark:bg-base-900 relative flex w-full transform flex-col justify-between bg-white p-8 transition-transform duration-500"
              class:list={[
                {
                  "mt-10 rounded-b-lg hover:-translate-y-2 sm:mt-0": plan.featured === true,
                },
                {
                  "border-base-300 dark:border-base-800 rounded-lg border border-dashed opacity-85":
                    plan.comingSoon === true,
                },
                {
                  "rounded-lg hover:-translate-y-2":
                    plan.featured !== true && plan.comingSoon !== true,
                },
              ]}
            >
              {plan.featured === true && (
                <div>
                  <Image
                    src={bestValueImage}
                    class="absolute -top-32 right-8 z-10 hidden md:block dark:invert"
                    alt="best value"
                    loading="lazy"
                    width={170}
                    densities={[1.5, 2]}
                  />
                  <div class="from-gradient-1 via-gradient-2 to-gradient-3 absolute -top-10 left-0 w-full rounded-t-xl bg-linear-40">
                    <p class="py-2 text-center font-semibold tracking-tight text-white">
                      Recommended
                    </p>
                  </div>
                </div>
              )}

              <div>
                <div class="text-center">
                  <h3 class="mb-1 text-xl font-bold tracking-tight">{plan.name}</h3>
                  <p class="text-primary-600 dark:text-primary-400 mb-6 text-xs font-semibold tracking-wider uppercase">
                    {plan.subtitle}
                  </p>
                  <h4>
                    <span class="text-xl font-semibold tracking-tight">$</span>
                    <span class="pricing-monthly font-sans text-5xl font-bold tracking-tighter xl:text-6xl">
                      {plan.price.monthly}
                    </span>
                    <span class="pricing-yearly hidden font-sans text-5xl font-bold tracking-tighter xl:text-6xl">
                      {plan.price.yearly}
                    </span>
                  </h4>
                  <p class="description mb-7 text-sm tracking-tight">
                    <span class="pricing-monthly">per month</span>
                    <span class="pricing-yearly hidden">per year</span>
                  </p>

                  <div class="border-base-200 dark:border-base-800 border-opacity-60 border-t border-b py-6">
                    <p class="description mx-auto max-w-xs text-sm tracking-tight">
                      {plan.description}
                    </p>
                  </div>
                </div>
                <ul class="py-6">
                  {plan.features.map((feature) => (
                    <li class="mb-2.5 flex items-start justify-start gap-2.5">
                      <Icon
                        name="tabler/check"
                        class:list={[
                          "mt-0.5 size-5 shrink-0",
                          plan.comingSoon
                            ? "text-base-400 dark:text-base-500"
                            : "text-primary-600 dark:text-primary-400",
                        ]}
                        aria-hidden="true"
                      />
                      <span class="text-start text-sm font-medium">{feature}</span>
                    </li>
                  ))}
                </ul>
              </div>
              <div class="text-center">
                {plan.comingSoon === true ? (
                  <button
                    type="button"
                    disabled
                    aria-disabled="true"
                    class="border-base-300 bg-base-200/70 text-base-600 dark:border-base-700 dark:bg-base-800/70 dark:text-base-400 w-full cursor-not-allowed rounded-full border border-dashed px-6 py-3 text-sm font-semibold select-none"
                  >
                    {plan.linkText}
                  </button>
                ) : (
                  <>
                    <Show when="signed-out" isStatic={true}>
                      <Button
                        data-pricing-waitlist-btn
                        class="w-full duration-300"
                        variant={plan.featured === true ? "primary" : "secondary"}
                        href={getLocalizedRoute(currLocale, plan.href ?? "/waitlist")}
                      >
                        {plan.linkText}
                      </Button>
                    </Show>
                    <Show when="signed-in" isStatic={true}>
                      <div class="flex flex-col items-center gap-2">
                        <UserWaitlistAvatar label="On the Waitlist • Free" class="w-full justify-center py-2.5" />
                      </div>
                    </Show>
                  </>
                )}
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<script>
  import { readWaitlistStatus } from "@js/waitlistStorage.mjs";

  import type { SwitchChangeEvent } from "@/components/starwind/switch";

  function syncPricingWaitlistButtons() {
    const status = readWaitlistStatus();
    if (!status?.joined) return;
    document.querySelectorAll<HTMLElement>("[data-pricing-waitlist-btn]").forEach((btn) => {
      btn.textContent = "On the Waitlist ✓";
    });
  }

  function pricingPlanToggleSetup() {
    syncPricingWaitlistButtons();
    const pricingSection = document.getElementById("pricing-four-cards");
    const toggle = pricingSection?.querySelector("#pricing-four-cards__toggle");
    const monthlyPrices = pricingSection?.querySelectorAll(".pricing-monthly");
    const yearlyPrices = pricingSection?.querySelectorAll(".pricing-yearly");

    if (!toggle || !monthlyPrices || !yearlyPrices) return;

    toggle.addEventListener("starwind-switch:change", (e: Event) => {
      const event = e as SwitchChangeEvent;
      const isYearly = event.detail.checked;

      monthlyPrices.forEach((price) => price.classList.toggle("hidden", isYearly));
      yearlyPrices.forEach((price) => price.classList.toggle("hidden", !isYearly));
    });
  }

  // runs on initial page load
  pricingPlanToggleSetup();

  // runs on view transitions navigation
  document.addEventListener("astro:after-swap", pricingPlanToggleSetup);
</script>
