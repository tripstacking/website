{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tripstacking",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": true,
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist/client",
    "not_found_handling": "404-page"
  }
}
